# Virtualenv — recreated from requirements.txt, never committed
.venv/

# Python caches
__pycache__/
*.pyc

# OS cruft
.DS_Store

# Trained model binaries are build outputs — regenerate with `python -m src.train`.
# The text registry pointer (current_best.json) and eval reports stay committed.
models/**/*.pkl

# Generated data: demo batches and the growing training table are build outputs
# (regenerate with scripts/make_demo_batches.py + src/ingest.py). Raw data stays.
data/incoming/*.csv
data/training_data.csv
data/ingestion_log.csv
data/rejects/*.csv

# Scratch outputs
*.tmp
scratch/
