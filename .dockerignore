# Keep the build context small and the image clean. The model is trained during
# the build (see Dockerfile), so local models/ and generated data are excluded.
.venv/
.git/
.gitignore
__pycache__/
*.pyc
.pytest_cache/
tests/
docs/
data/incoming/
data/scored/
data/rejects/
data/training_data.csv
data/ingestion_log.csv
models/
artifacts/
.DS_Store
